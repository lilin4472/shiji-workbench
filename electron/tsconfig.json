{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "../dist-electron",
    "rootDir": "..",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["*.ts", "*.cts", "../shared/**/*.ts"],
  "exclude": ["**/*.test.ts", "../shared/**/*.test.ts"]
}
